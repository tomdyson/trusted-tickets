# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-python-secrets
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database
# For SQLite (development): Leave DATABASE_URL unset or use sqlite:///db.sqlite3
# For PostgreSQL (production): Use format below
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email Configuration (Resend SMTP)
EMAIL_HOST_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=Your Event <noreply@yourdomain.com>

# Optional: Port for Gunicorn (Coolify sets this automatically)
PORT=8000
